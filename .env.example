# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Google Ads (server-side)
GOOGLE_ADS_CLIENT_ID=your_google_ads_oauth_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_oauth_client_secret_here
GOOGLE_ADS_REDIRECT_URI=https://seu-dominio.com/auth/callback
# A aprovação de acesso Google Ads é feita no projeto Google Cloud do OAuth.
# Não é necessário developer token (migração Google em setembro/2026).

# Meta / Facebook
META_ACCESS_TOKEN=your_meta_access_token_here
VITE_META_ACCESS_TOKEN=your_meta_access_token_here
VITE_META_APP_ID=your_meta_app_id_here

# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase privado (somente servidor; nunca prefixar com VITE_)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Login da plataforma (somente servidor)
AUTH_EMAIL=your_email_here
AUTH_PASS=your_password_here
AUTH_SESSION_SECRET=your_random_session_secret_here
# Compatibilidade com identificação de relatórios existentes (não é uma senha)
VITE_AUTH_EMAIL=your_email_here

# Assistente IA (use GEMINI_API_KEY gratuita ou ANTHROPIC_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Envio manual de relatórios ao Slack (somente no servidor)
# Um webhook exclusivo por agência. Configure no ambiente da Vercel; não use prefixo VITE_ neste bloco.
CRON_SECRET=your_random_cron_secret_here
SLACK_WEBHOOK_ALERTS=your_existing_slack_webhook_here
SLACK_WEBHOOK_REPORTS_TAGB=
SLACK_WEBHOOK_REPORTS_GDM=
SLACK_WEBHOOK_REPORTS_VILASMKT=
