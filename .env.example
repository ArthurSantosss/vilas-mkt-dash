# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_ADS_CLIENT_ID=your_google_ads_oauth_client_id_here

# Google Ads (server-side)
GOOGLE_ADS_CLIENT_ID=your_google_ads_oauth_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_oauth_client_secret_here
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token_here

# Meta / Facebook
META_ACCESS_TOKEN=your_meta_access_token_here
VITE_META_ACCESS_TOKEN=your_meta_access_token_here
VITE_META_APP_ID=your_meta_app_id_here

# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Auth credentials (temporary — migrate to Supabase Auth)
VITE_AUTH_EMAIL=your_email_here
VITE_AUTH_PASS=your_password_here

# Assistente IA (use GEMINI_API_KEY gratuita ou ANTHROPIC_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Envio manual de relatórios ao Slack (somente no servidor)
# Um webhook exclusivo por agência. Configure no ambiente da Vercel; não use prefixo VITE_ neste bloco.
CRON_SECRET=your_random_cron_secret_here
SLACK_WEBHOOK_ALERTS=your_existing_slack_webhook_here
SLACK_WEBHOOK_REPORTS_TAGB=
SLACK_WEBHOOK_REPORTS_GDM=
SLACK_WEBHOOK_REPORTS_VILASMKT=
